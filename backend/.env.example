# ==============================================================================
# Vedantu Online Coding Assessment Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development:
# cp .env.example .env

# Core Application Settings
PROJECT_NAME="Vedantu Coding Assessment Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (JSON array string or comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
