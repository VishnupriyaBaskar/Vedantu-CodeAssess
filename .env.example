# ==============================================================================
# Vedantu Online Coding Assessment Platform - Root Environment Configuration
# ==============================================================================
# Copy this file to .env in local development:
# cp .env.example .env

# ------------------------------------------------------------------------------
# PostgreSQL 16 Database Configuration (Application Data)
# ------------------------------------------------------------------------------
# Database name, master username, and secure password for local development
POSTGRES_DB=vedantu_assessment_db
POSTGRES_USER=vedantu_admin
POSTGRES_PASSWORD=replace_with_secure_dev_password
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis 7 In-Memory Cache & Message Broker Configuration (Application Data)
# ------------------------------------------------------------------------------
# Redis authentication password and local port
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Judge0 Community Edition v1.13.1 Configuration (Stage 2.5)
# ------------------------------------------------------------------------------
# Judge0 API location (Host loopback binding for local dev)
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_PORT=2358

# Judge0 API Authentication (AUTHN_HEADER & AUTHN_TOKEN)
JUDGE0_AUTHN_HEADER=X-Auth-Token
JUDGE0_AUTHN_TOKEN=replace_with_secure_judge0_token

# Dedicated Judge0 Database & Queue Credentials (Strictly Isolated from App DB)
JUDGE0_DB_USER=judge0_admin
JUDGE0_DB_PASSWORD=replace_with_secure_judge0_db_password
JUDGE0_REDIS_PASSWORD=replace_with_secure_judge0_redis_password

# ------------------------------------------------------------------------------
# Backend Internal Development Security
# ------------------------------------------------------------------------------
# Secret header required for POST /api/v1/internal/judge0/execute
INTERNAL_DEV_SECRET=replace_with_secure_internal_dev_secret

# ------------------------------------------------------------------------------
# JWT Authentication & RBAC Configuration (Stage 3)
# ------------------------------------------------------------------------------
# Secret key used for signing HMAC-SHA256 JWT tokens (minimum 32 characters)
JWT_SECRET_KEY=replace_with_secure_jwt_secret_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=vedantu-assessment-platform
JWT_AUDIENCE=vedantu-assessment-users

# ------------------------------------------------------------------------------
# Frontend & Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# Client API base path (/api/v1 for same-origin proxy, or full URL)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# Database Migration Runner Flag
# ------------------------------------------------------------------------------
# Set to true to execute 'alembic upgrade head' on backend startup
RUN_MIGRATIONS=false

# ------------------------------------------------------------------------------
# AI Evaluation & Static Analysis Configuration (Stage 5)
# ------------------------------------------------------------------------------
# Provider choice: "mock" (default, zero cost) or "gemini" (optional external)
AI_EVALUATION_ENABLED=true
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=15.0
